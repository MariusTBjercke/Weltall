# Copy to local.env and fill in the paths for this machine.
# local.env is git-ignored; this example is not packaging input and is never shipped.

# The Unreal Engine to compile, cook and package with (the launcher's install is fine).
UE_ROOT=C:\Program Files\Epic Games\UE_5.8

# Where Scripts/build.ps1 points at the newest build, so the game always starts from one path.
# It becomes a directory junction to out/builds/<Configuration>/Windows.
WELTALL_PLAY_DIR=D:\Games\Weltall

# Only needed for Linux packages: the engine's cross-compile toolchain, and the WSL distro its check runs in.
# LINUX_MULTIARCH_ROOT=
# WSL_DISTRO=

# Only needed for Android packages.
# ANDROID_HOME=
# NDKROOT=
# ANDROID_JAVA_HOME=
# ANDROID_AVD=
# ANDROID_CHECK_DISC=
# ANDROID_KEYSTORE=
# ANDROID_KEYSTORE_PASSWORD=
